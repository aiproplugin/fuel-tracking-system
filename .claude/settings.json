{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm install)",
      "Bash(npm install *)",
      "Bash(npm ci)",
      "Bash(npm run dev)",
      "Bash(npm run dev *)",
      "Bash(npm run build)",
      "Bash(npm run start)",
      "Bash(npm run test)",
      "Bash(npm run test *)",
      "Bash(npm run lint)",
      "Bash(npm run lint *)",
      "Bash(npm run typecheck)",
      "Bash(npm run format)",
      "Bash(npm run format *)",
      "Bash(npm audit)",
      "Bash(npx prisma *)",
      "Bash(npx vitest *)",
      "Bash(npx tsc *)",
      "Bash(docker compose *)"
    ],
    "deny": ["Read(./.env)", "Read(./.env.*)"]
  }
}
