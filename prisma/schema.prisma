// Fuel Usage & Stock Tracking System — complete data model (Phase 1).
//
// Conventions:
// - Table/column names are snake_case via @@map/@map; TS side is camelCase.
// - All timestamps are timestamptz and stored in UTC (rendered Asia/Colombo in UI).
// - Fuel quantities are Decimal(12,2) liters; usage meters are integers in
//   whole units of the vehicle type's meter (km / hrs / kWh).
// - stock_movement is the SACRED append-only ledger: BigInt autoincrement id
//   gives strict insertion order; every quantity change stores balance_after.
//   tank.current_stock is only a cache of the latest movement's balance_after.
// - unit_cost columns exist but are hidden in UI (v1 out of scope).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Role {
  OPERATOR
  SUPERVISOR
  MANAGER
  ADMIN
}

// A vehicle may only be fuelled from a tank of the SAME type — the mismatch
// hard block is a plain equality check, so it holds for every value here.
// Extensible: adding a type = one enum value here plus one FUEL_CONFIG entry
// in src/lib/fuel.ts (completeness is unit-tested).
enum FuelType {
  PETROL
  DIESEL
  KEROSENE
}

// What a vehicle type's monotonically-increasing usage meter measures.
// Efficiency is ALWAYS meter-delta per litre (km/L, hrs/L, kWh/L) — higher is
// better for every type. Extensible: adding a type = one enum value here plus
// one METER_CONFIG entry in src/lib/meter.ts (completeness is unit-tested).
enum MeterType {
  DISTANCE // odometer, km
  HOURS // hour meter, hrs
  ENERGY // energy meter, kWh
}

// Direction of a per-user permission override. DENY always beats GRANT and
// the role bundle alike (see resolveEffectivePermissions).
enum PermissionMode {
  GRANT
  DENY
}

// Standardised loss/variance categories for a stock adjustment, recorded
// ALONGSIDE the free-text detail (never instead of it) so shrinkage can be
// analysed by cause. Purely descriptive — no stock maths branches on it.
// Adding a category = one enum value here plus one ADJUSTMENT_REASON_CONFIG
// entry in src/lib/adjustment-reason.ts (completeness is unit-tested).
enum AdjustmentReason {
  UNAUTHORIZED_EXTRACTION // siphoning, off-hours or unrecorded dispensing
  DISPENSING_INACCURACY // logbook errors, uncalibrated meters, estimates
  LEAK_OR_SPILL // faulty nozzles, corrosion, hose damage, overfill
  EVAPORATION_OR_SLUDGE // temperature/condensation loss, tank-bottom sediment
}

enum MovementType {
  ISSUE
  DELIVERY
  ADJUSTMENT
}

enum ExceptionStatus {
  PENDING
  APPROVED
  REJECTED
}

// Quota amount+period ALWAYS travel together as one pair: every layer that
// stores a quota stores BOTH columns, guarded by a CHECK that they are set or
// null together (see the company_and_quota_system migration).
enum QuotaPeriod {
  DAILY
  WEEKLY
  MONTHLY
}

// Per-vehicle quota setting: INHERIT falls through the waterfall
// (company -> vehicle type -> global -> none); CUSTOM supplies its own pair;
// EXEMPT means explicitly no quota, ignoring every default below.
enum QuotaMode {
  INHERIT
  CUSTOM
  EXEMPT
}

enum QuotaEnforcementMode {
  OFF
  WARN_OVERRIDE
  HARD_BLOCK
}

enum WeekStartDay {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum AuditAction {
  LOGIN_SUCCESS
  LOGIN_FAILURE
  LOGIN_RATE_LIMITED
  ACCOUNT_LOCKED
  LOGOUT
  PASSWORD_SET
  PASSWORD_RESET
  PASSWORD_CHANGED
  USER_CREATED
  USER_UPDATED
  ROLE_CHANGED
  TANK_ASSIGNED
  METER_OVERRIDE
  METER_EXCEPTION_FLAGGED
  METER_EXCEPTION_REVIEWED
  FUEL_ISSUED
  DELIVERY_RECORDED
  ADJUSTMENT_RECORDED
  QR_TOKEN_CREATED
  QR_TOKEN_ROTATED
  QR_TOKEN_DEACTIVATED
  SETTINGS_CHANGED
  SITE_CREATED
  SITE_UPDATED
  SITE_DELETED
  TANK_CREATED
  TANK_UPDATED
  VEHICLE_CREATED
  VEHICLE_UPDATED
  REPORT_EXPORTED
  COMPANY_CREATED
  COMPANY_UPDATED
  COMPANY_DELETED
  QUOTA_SETTINGS_CHANGED
  QUOTA_ASSIGNED
  QUOTA_OVERRIDE_CODE_ISSUED
  QUOTA_OVERRIDE
  QUOTA_TOPUP
  PERMISSION_GRANTED
  PERMISSION_DENIED
  PERMISSION_OVERRIDE_REMOVED
}

// ---------------------------------------------------------------------------
// Organization & people
// ---------------------------------------------------------------------------

// Group company (Macktiles, Multilac, Mandarina, ...). Owns sites and
// vehicles; may carry a default quota pair for all of its vehicles.
model Company {
  id                 String       @id @default(uuid())
  name               String       @unique
  defaultQuotaLiters Decimal?     @map("default_quota_liters") @db.Decimal(12, 2)
  defaultQuotaPeriod QuotaPeriod? @map("default_quota_period")
  createdAt          DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  sites    Site[]
  vehicles Vehicle[]

  @@map("company")
}

model Site {
  id        String   @id @default(uuid())
  name      String   @unique
  companyId String   @map("company_id")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  company Company @relation(fields: [companyId], references: [id])

  tanks Tank[]
  users User[]

  @@index([companyId])
  @@map("site")
}

// Mapped to app_user ("user" is reserved in raw SQL sessions).
model User {
  id                 String    @id @default(uuid())
  username           String    @unique // stored lowercase; normalized at login
  passwordHash       String    @map("password_hash")
  displayName        String    @map("display_name")
  role               Role
  isActive           Boolean   @default(true) @map("is_active")
  // True after an admin sets/resets the password; the user is forced to
  // choose their own password at next sign-in before using the app.
  mustChangePassword Boolean   @default(false) @map("must_change_password")
  defaultTankId      String?   @map("default_tank_id")
  siteId             String?   @map("site_id")
  failedLoginCount   Int       @default(0) @map("failed_login_count")
  lockedUntil        DateTime? @map("locked_until") @db.Timestamptz(3)
  lastLoginAt        DateTime? @map("last_login_at") @db.Timestamptz(3)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  defaultTank Tank? @relation("OperatorDefaultTank", fields: [defaultTankId], references: [id])
  site        Site? @relation(fields: [siteId], references: [id])

  fuelTransactions    FuelTransaction[]   @relation("TransactionOperator")
  meterOverrides      FuelTransaction[]   @relation("TransactionOverrideAdmin")
  quotaOverrides      FuelTransaction[]   @relation("TransactionQuotaOverrideBy")
  deliveries          Delivery[]
  adjustments         StockAdjustment[]
  stockMovements      StockMovement[]
  auditLogs           AuditLog[]
  flaggedExceptions   MeterException[]    @relation("ExceptionOperator")
  reviewedExceptions  MeterException[]    @relation("ExceptionReviewer")
  quotaTopUpsGranted  QuotaTopUp[]        @relation("TopUpGrantedBy")
  overrideCodesIssued QuotaOverrideCode[] @relation("OverrideCodeIssuedBy")

  permissionOverrides UserPermissionOverride[] @relation("UserOverrides")
  permissionsGranted  UserPermissionOverride[] @relation("OverrideGrantedBy")

  @@map("app_user")
}

// Per-user deviation from the role's default permission bundle. A user with
// no rows here has exactly their role's permissions — which is every user at
// the moment this table is introduced, so behaviour is unchanged on deploy.
//
// The unique(user, permission) pair makes a simultaneous GRANT and DENY of the
// same permission structurally impossible; the resolver in src/lib/permissions.ts
// still applies denials last, so denials win under any circumstance.
//
// `permission` is a catalogue key from src/lib/permissions.ts, validated by Zod
// on every write. It is deliberately NOT a Prisma enum: the catalogue lives in
// exactly ONE module, and rows naming a retired key are ignored by the
// resolver rather than widening anyone's access.
model UserPermissionOverride {
  id          String         @id @default(uuid())
  userId      String         @map("user_id")
  permission  String         @db.VarChar(64)
  mode        PermissionMode
  grantedById String         @map("granted_by")
  reason      String         @db.VarChar(500)
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  user      User @relation("UserOverrides", fields: [userId], references: [id], onDelete: Cascade)
  grantedBy User @relation("OverrideGrantedBy", fields: [grantedById], references: [id])

  @@unique([userId, permission])
  @@index([userId])
  @@map("user_permission_override")
}

// Optional and fully modeled; driver reports stay hidden until enabled.
model Driver {
  id         String   @id @default(uuid())
  name       String
  employeeNo String?  @unique @map("employee_no")
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  fuelTransactions FuelTransaction[]

  @@map("driver")
}

// ---------------------------------------------------------------------------
// Assets
// ---------------------------------------------------------------------------

model Tank {
  id                String   @id @default(uuid())
  name              String   @unique
  siteId            String   @map("site_id")
  fuelType          FuelType @map("fuel_type")
  capacityLiters    Decimal  @map("capacity_liters") @db.Decimal(12, 2)
  // Cache of the latest stock_movement.balance_after — never authoritative.
  currentStock      Decimal  @default(0) @map("current_stock") @db.Decimal(12, 2)
  lowStockThreshold Decimal  @map("low_stock_threshold") @db.Decimal(12, 2)
  isActive          Boolean  @default(true) @map("is_active")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  site Site @relation(fields: [siteId], references: [id])

  operators        User[]            @relation("OperatorDefaultTank")
  movements        StockMovement[]
  fuelTransactions FuelTransaction[]
  deliveries       Delivery[]
  adjustments      StockAdjustment[]
  exceptions       MeterException[]

  @@map("tank")
}

// Per-vehicle-type efficiency bounds = the abnormal-consumption band
// (Settings screen), in the type's own efficiency unit (km/L, hrs/L, kWh/L).
// meter_type is intrinsic to the class (all forklifts are hour-metered);
// vehicles inherit it from their type — there is NO per-vehicle meter type.
model VehicleType {
  id                 String       @id @default(uuid())
  name               String       @unique
  meterType          MeterType    @default(DISTANCE) @map("meter_type")
  minEfficiency      Decimal      @map("min_efficiency") @db.Decimal(6, 2)
  maxEfficiency      Decimal      @map("max_efficiency") @db.Decimal(6, 2)
  // Optional type-level quota default (amount+period pair, set/cleared together).
  defaultQuotaLiters Decimal?     @map("default_quota_liters") @db.Decimal(12, 2)
  defaultQuotaPeriod QuotaPeriod? @map("default_quota_period")
  createdAt          DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  vehicles Vehicle[]

  @@map("vehicle_type")
}

model Vehicle {
  id                String       @id @default(uuid())
  plateNumber       String       @unique @map("plate_number")
  vehicleTypeId     String       @map("vehicle_type_id")
  // Owning group company — stored explicitly (quota resolution reads it
  // directly; vehicles are not site-bound).
  companyId         String       @map("company_id")
  fuelType          FuelType     @map("fuel_type")
  // Cache of the highest accepted meter reading (source of truth:
  // fuel_transaction), in the vehicle type's meter unit.
  currentMeter      Int          @default(0) @map("current_meter")
  // Individual quota layer: INHERIT (waterfall), CUSTOM (own pair), EXEMPT.
  quotaMode         QuotaMode    @default(INHERIT) @map("quota_mode")
  customQuotaLiters Decimal?     @map("custom_quota_liters") @db.Decimal(12, 2)
  customQuotaPeriod QuotaPeriod? @map("custom_quota_period")
  isActive          Boolean      @default(true) @map("is_active")
  createdAt         DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  vehicleType VehicleType @relation(fields: [vehicleTypeId], references: [id])
  company     Company     @relation(fields: [companyId], references: [id])

  qrTokens         QrToken[]
  fuelTransactions FuelTransaction[]
  exceptions       MeterException[]
  quotaTopUps      QuotaTopUp[]
  overrideCodes    QuotaOverrideCode[]

  @@index([companyId])
  @@map("vehicle")
}

// Opaque lookup tokens — NEVER the plate, NEVER a column on vehicle.
// Rotation = deactivate old row + insert new row; vehicle history untouched.
model QrToken {
  id            String    @id @default(uuid())
  token         String    @unique
  vehicleId     String    @map("vehicle_id")
  isActive      Boolean   @default(true) @map("is_active")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  deactivatedAt DateTime? @map("deactivated_at") @db.Timestamptz(3)

  vehicle Vehicle @relation(fields: [vehicleId], references: [id])

  @@index([vehicleId])
  @@map("qr_token")
}

// ---------------------------------------------------------------------------
// Fuel activity (headers) + the ledger
// ---------------------------------------------------------------------------

model FuelTransaction {
  id                   String   @id @default(uuid())
  // Client-generated; dedupes retries/double-taps (unique = the guarantee).
  idempotencyKey       String   @unique @map("idempotency_key")
  vehicleId            String   @map("vehicle_id")
  tankId               String   @map("tank_id")
  operatorId           String   @map("operator_id")
  driverId             String?  @map("driver_id")
  liters               Decimal  @db.Decimal(10, 2)
  meterReading         Int      @map("meter_reading")
  previousMeterReading Int      @map("previous_meter_reading")
  meterOverride        Boolean  @default(false) @map("meter_override")
  overrideReason       String?  @map("override_reason")
  overrideByUserId     String?  @map("override_by_user_id")
  // Efficiency of the PREVIOUS fill: (reading - previous) / liters at previous
  // fill, in the vehicle type's unit per litre (km/L, hrs/L, kWh/L).
  // Null on first fill (no baseline) — expected, not an error.
  efficiency           Decimal? @db.Decimal(6, 2)
  isAbnormal           Boolean  @default(false) @map("is_abnormal")
  // True when this issue exceeded the vehicle's quota and was authorised via
  // a supervisor override code; quota_override_by = the code's issuer.
  quotaOverride        Boolean  @default(false) @map("quota_override")
  quotaOverrideById    String?  @map("quota_override_by_id")
  unitCost             Decimal? @map("unit_cost") @db.Decimal(10, 2)
  issuedAt             DateTime @map("issued_at") @db.Timestamptz(3) // may be backdated
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  vehicle         Vehicle @relation(fields: [vehicleId], references: [id])
  tank            Tank    @relation(fields: [tankId], references: [id])
  operator        User    @relation("TransactionOperator", fields: [operatorId], references: [id])
  driver          Driver? @relation(fields: [driverId], references: [id])
  overrideBy      User?   @relation("TransactionOverrideAdmin", fields: [overrideByUserId], references: [id])
  quotaOverrideBy User?   @relation("TransactionQuotaOverrideBy", fields: [quotaOverrideById], references: [id])

  movement StockMovement?

  @@index([vehicleId, issuedAt])
  @@index([tankId, issuedAt])
  @@map("fuel_transaction")
}

model Delivery {
  id             String   @id @default(uuid())
  // Client-minted per form open; dedupes double-submits (nullable: seed and
  // pre-Phase-4 rows have none).
  idempotencyKey String?  @unique @map("idempotency_key")
  tankId         String   @map("tank_id")
  receivedById   String   @map("received_by_id")
  liters         Decimal  @db.Decimal(12, 2)
  supplierName   String?  @map("supplier_name")
  referenceNo    String?  @map("reference_no")
  unitCost       Decimal? @map("unit_cost") @db.Decimal(10, 2)
  deliveredAt    DateTime @map("delivered_at") @db.Timestamptz(3) // may be backdated
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  tank       Tank @relation(fields: [tankId], references: [id])
  receivedBy User @relation(fields: [receivedById], references: [id])

  movement StockMovement?

  @@index([tankId, deliveredAt])
  @@map("delivery")
}

model StockAdjustment {
  id             String           @id @default(uuid())
  idempotencyKey String?          @unique @map("idempotency_key")
  tankId         String           @map("tank_id")
  adjustedById   String           @map("adjusted_by_id")
  // Signed liters: negative = shrinkage/correction down, positive = correction up.
  quantityChange Decimal          @map("quantity_change") @db.Decimal(12, 2)
  // BOTH are required: the category drives loss-by-cause reporting, the
  // free-text reason carries the specifics. Neither substitutes for the other.
  reasonCategory AdjustmentReason @map("reason_category")
  reason         String
  adjustedAt     DateTime         @map("adjusted_at") @db.Timestamptz(3)
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  tank       Tank @relation(fields: [tankId], references: [id])
  adjustedBy User @relation(fields: [adjustedById], references: [id])

  movement StockMovement?

  @@index([tankId, adjustedAt])
  @@index([reasonCategory, adjustedAt])
  @@map("stock_adjustment")
}

// THE LEDGER. Append-only; never updated, never deleted.
// BigInt autoincrement id = strict insertion order even with backdated
// issued_at/delivered_at timestamps on the source records.
model StockMovement {
  id                BigInt       @id @default(autoincrement())
  tankId            String       @map("tank_id")
  type              MovementType
  // Signed liters: ISSUE negative, DELIVERY positive, ADJUSTMENT either.
  quantity          Decimal      @db.Decimal(12, 2)
  balanceAfter      Decimal      @map("balance_after") @db.Decimal(12, 2)
  fuelTransactionId String?      @unique @map("fuel_transaction_id")
  deliveryId        String?      @unique @map("delivery_id")
  adjustmentId      String?      @unique @map("adjustment_id")
  createdById       String       @map("created_by_id")
  createdAt         DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  tank            Tank             @relation(fields: [tankId], references: [id])
  fuelTransaction FuelTransaction? @relation(fields: [fuelTransactionId], references: [id])
  delivery        Delivery?        @relation(fields: [deliveryId], references: [id])
  adjustment      StockAdjustment? @relation(fields: [adjustmentId], references: [id])
  createdBy       User             @relation(fields: [createdById], references: [id])

  @@index([tankId, id])
  @@map("stock_movement")
}

// ---------------------------------------------------------------------------
// Fuel quotas
// ---------------------------------------------------------------------------

// Singleton row (id = 1): the global quota configuration. enforcement_enabled
// is the master switch — OFF preserves all configured quotas but disables
// every quota check and display. global_quota_* is the group-wide catch-all
// pair at the bottom of the resolution waterfall.
model QuotaSettings {
  id                  Int                  @id @default(1)
  enforcementEnabled  Boolean              @default(false) @map("enforcement_enabled")
  enforcementMode     QuotaEnforcementMode @default(WARN_OVERRIDE) @map("enforcement_mode")
  warningThresholdPct Int                  @default(80) @map("warning_threshold_pct")
  weekStartDay        WeekStartDay         @default(MONDAY) @map("week_start_day")
  globalQuotaLiters   Decimal?             @map("global_quota_liters") @db.Decimal(12, 2)
  globalQuotaPeriod   QuotaPeriod?         @map("global_quota_period")
  updatedAt           DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("quota_settings")
}

// One-off extra litres for a vehicle, valid only inside the period window
// that was current when granted (window boundaries frozen at grant time).
model QuotaTopUp {
  id          String   @id @default(uuid())
  vehicleId   String   @map("vehicle_id")
  liters      Decimal  @db.Decimal(10, 2)
  reason      String
  grantedById String   @map("granted_by_id")
  windowStart DateTime @map("window_start") @db.Timestamptz(3)
  windowEnd   DateTime @map("window_end") @db.Timestamptz(3)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  vehicle   Vehicle @relation(fields: [vehicleId], references: [id])
  grantedBy User    @relation("TopUpGrantedBy", fields: [grantedById], references: [id])

  @@index([vehicleId, windowStart])
  @@map("quota_top_up")
}

// Single-use supervisor authorisation for one over-quota fill (WARN_OVERRIDE
// mode). Only a sha256 hash of the 6-digit code is stored; the code is
// vehicle-bound, expires quickly, and is consumed atomically with the issue.
model QuotaOverrideCode {
  id                  String    @id @default(uuid())
  codeHash            String    @map("code_hash")
  vehicleId           String    @map("vehicle_id")
  issuedById          String    @map("issued_by_id")
  reason              String
  expiresAt           DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt              DateTime? @map("used_at") @db.Timestamptz(3)
  usedInTransactionId String?   @unique @map("used_in_transaction_id")
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  vehicle  Vehicle @relation(fields: [vehicleId], references: [id])
  issuedBy User    @relation("OverrideCodeIssuedBy", fields: [issuedById], references: [id])

  @@index([vehicleId, expiresAt])
  @@map("quota_override_code")
}

// ---------------------------------------------------------------------------
// Exceptions & audit
// ---------------------------------------------------------------------------

// Operator "flag for admin review" when a meter entry is blocked (M6/D6).
// Readings are in the vehicle type's meter unit (km / hrs / kWh).
model MeterException {
  id               String          @id @default(uuid())
  vehicleId        String          @map("vehicle_id")
  tankId           String          @map("tank_id")
  operatorId       String          @map("operator_id")
  // Liters of the blocked submission — the fuel already physically left the
  // tank, so an APPROVED review completes the ledger record with this amount.
  liters           Decimal         @db.Decimal(10, 2)
  previousReading  Int             @map("previous_reading")
  attemptedReading Int             @map("attempted_reading")
  status           ExceptionStatus @default(PENDING)
  correctedReading Int?            @map("corrected_reading")
  reviewReason     String?         @map("review_reason")
  reviewedById     String?         @map("reviewed_by_id")
  reviewedAt       DateTime?       @map("reviewed_at") @db.Timestamptz(3)
  createdAt        DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)

  vehicle    Vehicle @relation(fields: [vehicleId], references: [id])
  tank       Tank    @relation(fields: [tankId], references: [id])
  operator   User    @relation("ExceptionOperator", fields: [operatorId], references: [id])
  reviewedBy User?   @relation("ExceptionReviewer", fields: [reviewedById], references: [id])

  @@index([status, createdAt])
  @@map("meter_exception")
}

// Append-only. actor_id is null for failed logins against unknown usernames
// (the attempted username is deliberately NOT stored — it may be a password
// typed into the wrong field).
model AuditLog {
  id         BigInt      @id @default(autoincrement())
  actorId    String?     @map("actor_id")
  action     AuditAction
  entityType String?     @map("entity_type")
  entityId   String?     @map("entity_id")
  before     Json?
  after      Json?
  ipAddress  String?     @map("ip_address")
  createdAt  DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)

  actor User? @relation(fields: [actorId], references: [id])

  @@index([action, createdAt])
  @@index([actorId, createdAt])
  @@map("audit_log")
}
