// Fuel Usage & Stock Tracking System — Prisma schema.
// Phase 0: datasource + generator only. The full data model (users, roles,
// tanks, vehicles, stock_movement ledger, qr_token, audit_log, settings)
// is introduced in Phase 1.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
