# --- Docker build context excludes ---
# Goal: force a clean `npm ci` from package-lock.json only (reproduces the
# container environment) and keep secrets out of the image. Everything NOT
# listed here is sent to the build — in particular the build MUST keep:
#   package.json, package-lock.json, postcss.config.mjs, tailwind.config.ts,
#   next.config.mjs, tsconfig.json, src/, public/, prisma/

# Installed deps — must be rebuilt fresh inside the image
node_modules

# Build output — regenerated by `next build`
.next
out

# Secrets and local env — NEVER copy into an image (.env.example is fine to keep,
# but nothing in the image needs it, so exclude the whole family)
.env
.env.*

# VCS / tooling metadata
.git
.gitignore
.github

# Docker files themselves
Dockerfile
.dockerignore
docker-compose.yml

# Local-only / non-build artifacts
README.md
docs
coverage
*.log
npm-debug.log*
.vscode
.idea
.DS_Store
