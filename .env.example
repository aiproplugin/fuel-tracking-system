# ---------------------------------------------------------------------------
# Fuel Usage & Stock Tracking System — environment template
# Copy this file to .env and fill in real values. NEVER commit .env.
#   PowerShell:  Copy-Item .env.example .env
# ---------------------------------------------------------------------------

# PostgreSQL connection. The credentials below match docker-compose.yml
# defaults for LOCAL DEVELOPMENT ONLY — production uses a dedicated
# least-privilege DB user (see Phase 7 deployment notes).
DATABASE_URL="postgresql://fuel_app:fuel_dev_only_password@localhost:5432/fuel_tracking?schema=public"

# Auth.js session encryption secret. Generate a fresh one PER ENVIRONMENT:
#   PowerShell:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NEXTAUTH_SECRET="replace-with-a-generated-32-byte-base64-secret"

# Canonical app URL. Use https://... in production (enables Secure cookies).
NEXTAUTH_URL="http://localhost:3000"
