{
  "name": "fuel-tracking-system",
  "version": "0.1.0",
  "private": true,
  "description": "Fuel Usage & Stock Tracking System — internal operations portal for issued fuel, deliveries, stock, and audit control.",
  "author": "Waruna Fonseka <fonsekacws@gmail.com>",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "postinstall": "prisma generate",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:migrate": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "reconcile": "tsx scripts/reconcile.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "@radix-ui/react-dialog": "1.1.18",
    "@radix-ui/react-select": "2.3.2",
    "@tanstack/react-query": "5.101.2",
    "@tanstack/react-table": "8.21.3",
    "@trpc/client": "11.18.0",
    "@trpc/react-query": "11.18.0",
    "@trpc/server": "11.18.0",
    "argon2": "0.44.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "html5-qrcode": "2.3.8",
    "lucide-react": "1.23.0",
    "next": "14.2.35",
    "next-auth": "5.0.0-beta.31",
    "pino": "10.3.1",
    "qrcode": "1.5.4",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "superjson": "2.2.6",
    "tailwind-merge": "2.6.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "20.19.43",
    "@types/qrcode": "1.5.6",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "autoprefixer": "10.5.2",
    "eslint": "8.57.1",
    "eslint-config-next": "14.2.35",
    "eslint-config-prettier": "10.1.8",
    "postcss": "8.5.16",
    "prettier": "3.9.4",
    "prettier-plugin-tailwindcss": "0.8.0",
    "prisma": "6.19.3",
    "tailwindcss": "3.4.19",
    "tsx": "4.22.4",
    "typescript": "5.9.3",
    "vitest": "4.1.9"
  }
}
